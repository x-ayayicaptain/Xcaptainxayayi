{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "xcaptainxayayi-live",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "x-ayayi.de",
      "custom_domain": true
    }
  ]
}
